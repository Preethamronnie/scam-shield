# Optional. Enables simple explanations in Indian languages.
OPENAI_API_KEY=
# SCAMSHIELD_LLM_MODEL=gpt-4o-mini
# Optional. Path to Tesseract OCR if it isn't on your PATH (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
