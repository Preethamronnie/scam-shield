# Optional. Enables simple explanations in Indian languages.
OPENAI_API_KEY=
# SCAMSHIELD_LLM_MODEL=gpt-4o-mini
# Optional. Path to Tesseract OCR if it isn't on your PATH (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional threat databases for links (each independent; only used with "Use online services" on).
# GOOGLE_SAFE_BROWSING_KEY=     free, non-commercial (Google Cloud console)
# GOOGLE_WEB_RISK_KEY=          Google's commercial equivalent
# URLHAUS_AUTH_KEY=             abuse.ch (free account)
# PHISHTANK_APP_KEY=            PhishTank (not accepting new registrations at the time of writing)
# Domain age checks (rdap.org) need no key.
# Optional. Set to "off" to disable anonymised detection logging.
# SCAMSHIELD_LOG=on
# Optional. Where user feedback reports are queued for review.
# SCAMSHIELD_FEEDBACK_DIR=data/feedback
